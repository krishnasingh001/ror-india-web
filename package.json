{
  "name": "ror-india-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "demo:recruiter": "playwright test e2e/recruiter-flow.spec.ts --project=chromium",
    "demo:recruiter:ui": "playwright test e2e/recruiter-flow.spec.ts --ui",
    "demo:recruiter:collect": "node scripts/collect-demo-video.mjs recruiter-flow",
    "demo:pitch": "playwright test e2e/client-investor-demo.spec.ts --project=chromium",
    "demo:pitch:collect": "node scripts/collect-demo-video.mjs client-investor-demo",
    "demo:voiceover": "bash scripts/add-voiceover.sh",
    "demo:voiceover:synced": "bash scripts/add-synced-voiceover.sh",
    "demo:pitch:voice": "bash scripts/add-voiceover.sh",
    "demo:pitch:voice:synced": "bash scripts/add-synced-voiceover.sh",
    "demo:pitch:narrate": ".venv-kokoro/bin/python scripts/generate-investor-narration.py",
    "demo:pitch:flow": "bash scripts/mux-investor-flow.sh",
    "demo:investor": "npm run demo:pitch:narrate && DEMO_SLOW_MO=280 npm run demo:pitch && npm run demo:pitch:collect && node -e \"const fs=require('fs');const p='demo-videos';const v=fs.readdirSync(p).filter(f=>f.startsWith('client-investor-demo-')&&f.endsWith('.webm')).sort().pop();const t=v.replace('.webm','.timeline.json');console.log(v);require('child_process').execSync('bash scripts/mux-investor-flow.sh '+p+'/'+v+' '+p+'/'+t,{stdio:'inherit'})\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
